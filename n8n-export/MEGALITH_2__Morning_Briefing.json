      "id": "merge-data",
      "name": "Merge Data",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const patients = $('Get Patients').all();\nconst ops = $('Get Today Ops').all();\n\nconst today = new Date();\nconst dateStr = today.toLocaleDateString('uk-UA', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });\n\nlet vlkCritical = [];\nlet vlkWarning = [];\nlet overstay = [];\n\nfor (const p of patients) {\n  const f = p.json.fields || p.json;\n  const days = f['Дні з травми'] || 0;\n  const hospDays = f['Дні госпіталізації'] || 0;\n  const vlkStatus = f['ВЛК статус'] || '';\n  const name = f['ПІБ'] || 'Невідомо';\n  \n  if (!vlkStatus.includes('Пройдено')) {\n    if (days >= 120) vlkCritical.push({ name, days });\n    else if (days >= 100) vlkWarning.push({ name, days });\n  }\n  \n  if (hospDays >= 21) overstay.push({ name, days: hospDays });\n}\n\nlet text = `*РАНКОВИЙ БРИФІНГ - ${dateStr}*\\n\\n`;\ntext += `*Госпіталізовано:* ${patients.length} пацієнтів\\n\\n`;\n\nif (ops.length > 0) {\n  text += `*ОПЕРАЦІЇ СЬОГОДНІ (${ops.length}):*\\n`;\n  for (const o of ops) {\n    const f = o.json.fields || o.json;\n    text += `  - ${f['Пацієнт'] || 'TBD'} (${f['Хірург'] || '-'})\\n`;\n  }\n  text += '\\n';\n} else {\n  text += '*Операцій сьогодні немає*\\n\\n';\n}\n\nif (vlkCritical.length > 0) {\n  text += `*ПОТРІБНА ВЛК (${vlkCritical.length}):*\\n`;\n  for (const p of vlkCritical) text += `  - ${p.name} (${p.days} днів)\\n`;\n  text += '\\n';\n}\n\nif (vlkWarning.length > 0) {\n  text += `*До ВЛК (${vlkWarning.length}):*\\n`;\n  for (const p of vlkWarning) text += `  - ${p.name} (${p.days} днів)\\n`;\n  text += '\\n';\n}\n\nif (overstay.length > 0) {\n  text += `*ПЕРЕБУВАННЯ >21 день (${overstay.length}):*\\n`;\n  for (const p of overstay) text += `  - ${p.name} (${p.days} днів)\\n`;\n}\n\nreturn [{ json: { channel: 'C0AA2S3M0R5', text } }];"
      },
      "id": "format-briefing",
      "name": "Format Briefing",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ]
    },
