{
  "id": "ZRbqEpbzkSWNRRM6",
  "name": "Dovidka Cleanup (Daily)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24,
              "triggerAtHour": 2
            }
          ]
        }
      },
      "name": "Daily 2 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ],
      "id": "schedule-trigger"
    },
    {
      "parameters": {
        "operation": "list",
        "driveId": {
          "__rl": true,
          "value": "My Drive",
          "mode": "name"
        },
        "folderId": {
          "__rl": true,
          "value": "1ZL3RqSdNVcQ0Gabbz6GdCey59IWuB2EW",
          "mode": "id"
        },
        "filter": {
          "foldersOnly": false,
          "trashed": false
        },
        "options": {}
      },
      "name": "List Output Folder",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        400,
        300
      ],
      "id": "list-output-folder",
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "rMWvrK8pn4JH2Sl8",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all(); const now = new Date(); const oneDayAgo = new Date(now.getTime() - 24 * 60 * 60 * 1000); const oldDovidkas = items.filter(item => { const name = item.json.name || ''; const createdTime = new Date(item.json.createdTime); const isDovidka = name.toLowerCase().startsWith('dovidka_'); const isOld = createdTime < oneDayAgo; return isDovidka && isOld; }); if (oldDovidkas.length === 0) { return [{ json: { noFiles: true, message: 'No old Dovidka files to delete' } }]; } return oldDovidkas.map(item => ({ json: { id: item.json.id, name: item.json.name, createdTime: item.json.createdTime } }));"
      },
      "name": "Filter Old Dovidkas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        300
      ],
      "id": "filter-old-dovidkas"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.noFiles }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "notEquals"
              }
            }
          ]
        },
        "options": {}
      },
      "name": "Has Files?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        800,
        300
      ],
      "id": "has-files"
    },
    {
      "parameters": {
        "operation": "delete",
        "fileId": {
          "__rl": true,
          "value": "={{ $json.id }}",
          "mode": "id"
        }
      },
      "name": "Delete Old Dovidka",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        1000,
        200
      ],
      "id": "delete-old-dovidka",
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "rMWvrK8pn4JH2Sl8",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const deleted = $input.all(); const count = deleted.length; return [{ json: { deletedCount: count, timestamp: new Date().toISOString() } }];"
      },
      "name": "Log Cleanup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        200
      ],
      "id": "log-cleanup"
    },
    {
      "parameters": {},
      "name": "No Files to Delete",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1000,
        400
      ],
      "id": "no-files"
    }
  ],
  "connections": {
    "Daily 2 AM": {
      "main": [
        [
          {
            "node": "List Output Folder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "List Output Folder": {
      "main": [
        [
          {
            "node": "Filter Old Dovidkas",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Old Dovidkas": {
      "main": [
        [
          {
            "node": "Has Files?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Files?": {
      "main": [
        [
          {
            "node": "Delete Old Dovidka",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "No Files to Delete",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Delete Old Dovidka": {
      "main": [
        [
          {
            "node": "Log Cleanup",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner",
    "availableInMCP": false
  },
  "staticData": {
    "node:Daily 2 AM": {
      "recurrenceRules": [
        4
      ]
    }
  }
}
