function toTitleCase(str) {
  if (!str) return '';
  return str.toLowerCase().replace(/(?:^|\s|[-/])\S/g, (match) => match.toUpperCase());
}

function toSentenceCase(str) {
  if (!str) return '';
  return str.charAt(0).toUpperCase() + str.slice(1).toLowerCase();
}

const item = $input.item.json;

return {
  ...item,
  // Format workplace - convert from ALL CAPS
  'Заклад': toTitleCase(item['Заклад'] || ''),
  // Keep other fields as-is but ensure they exist
  'ПІБ': item['ПІБ'] || '',
  'Дата народження': item['Дата народження'] || '',
  'Дата госпіталізації': item['Дата госпіталізації'] || '',
  '№ історії': item['№ історії'] || '',
  'Хірург': item['Хірург'] || '',
  'Діагноз': item['Діагноз'] || '',
  'Повний діагноз': item['Повний діагноз'] || ''
};"},"id":"format-dovidka-data","name":"Format Dovidka Data","type":"n8n-nodes-base.code","typeVersion":2,"position":[1152,1216]},{"parameters":{"jsCode":"// Build prefilled Airtable form URL
const patient = $('Get Patient').first().json;
const recordId = $('Handle Discharge').first().json.recordId;
const responseUrl = $('Handle Discharge').first().json.responseUrl;

// Base form URL
const baseUrl = 'https://airtable.com/appv5BwoWyRhT6Lcr/pagdAqptA5xwIaole/edit';

// Build prefill params
const prefills = {
  'ПІБ': patient['ПІБ'] || '',
  'Дата народження': patient['Дата народження'] || '',
  '№ історії': patient['№ історії'] || '',
  'Хірург': patient['Хірург'] || '',
  'Палата': patient['Палата'] || '',
  'Дата госпіталізації': patient['Дата госпіталізації'] || '',
  'Заклад': patient['Заклад'] || '',
  'Місце проживання': patient['Місце проживання'] || '',
  'Рекомендації': patient['Рекомендації'] || ''
};

const params = Object.entries(prefills)
  .filter(([k, v]) => v !== '' && v !== null && v !== undefined)
  .map(([k, v]) => 'prefill_' + encodeURIComponent(k) + '=' + encodeURIComponent(v))
  .join('&');

const formUrl = baseUrl + '?' + params;

return [{
  json: {
    formUrl,
    patientName: patient['ПІБ'],
    recordId,
    responseUrl
  }
}];"},"name":"Build Form URL","type":"n8n-nodes-base.code","typeVersion":2,"position":[1104,512],"id":"build-form-url"},{"parameters":{"method":"POST","url":"={{ $json.responseUrl }}","sendBody":true,"specifyBody":"json","jsonBody":"={
