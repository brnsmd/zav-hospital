const patient = $input.first().json;
const recordId = $('Handle Fill Form').first().json.recordId;
const responseUrl = $('Handle Fill Form').first().json.responseUrl;

// Base form URL
const baseUrl = 'https://airtable.com/appv5BwoWyRhT6Lcr/pagdAqptA5xwIaole/edit';

// Date formatter: convert any date to DD.MM.YYYY
const formatDate = (dateStr) => {
  if (!dateStr) return '';
  try {
    const d = new Date(dateStr);
    if (isNaN(d.getTime())) return dateStr;
    const day = String(d.getDate()).padStart(2, '0');
    const month = String(d.getMonth() + 1).padStart(2, '0');
    const year = d.getFullYear();
    return `${day}.${month}.${year}`;
  } catch (e) {
    return dateStr;
  }
};

// Helper to truncate long values (Slack URL limit is 3000 chars)
const truncate = (str, maxLen = 100) => {
  if (!str) return '';
  const s = String(str);
  return s.length > maxLen ? s.substring(0, maxLen) + '...' : s;
};

// Build prefill params - limit long text fields, format dates
const prefills = {
  'ПІБ': patient['ПІБ'] || '',
  'Стать': patient['Стать'] || '',
  'Дата народження': formatDate(patient['Дата народження']),
  'Діагноз': truncate(patient['Діагноз'], 150),
  // SKIP Повний діагноз - too long for Slack URL
  '№ історії': patient['№ історії'] || '',
  'Хірург': patient['Хірург'] || '',
  'Палата': patient['Палата'] || '',
  'Дата госпіталізації': formatDate(patient['Дата госпіталізації']),
  'Заклад': truncate(patient['Заклад'], 100),
  'Місце проживання': truncate(patient['Місце проживання'], 100),
  'Рекомендації': truncate(patient['Рекомендації'], 200),
  'Дата ВЛК': formatDate(patient['Дата ВЛК']),
  'Рішення ВЛК': patient['Рішення ВЛК'] || '',
  'Дні продовження': patient['Дні продовження'] || ''
};

const params = Object.entries(prefills)
  .filter(([k, v]) => v !== '' && v !== null && v !== undefined)
  .map(([k, v]) => 'prefill_' + encodeURIComponent(k) + '=' + encodeURIComponent(String(v)))
  .join('&');

const formUrl = params ? baseUrl + '?' + params : baseUrl;

return [{
  json: {
    formUrl,
    patientName: patient['ПІБ'] || 'Невідомо',
    recordId,
    responseUrl
  }
}];"},"id":"28971a5e-c648-4674-83ac-240bb8253f34","name":"Build Form URL Fill","type":"n8n-nodes-base.code","typeVersion":2,"position":[1168,800]}]|{"Slack Interactive":{"main":[[{"node":"Parse Payload","type":"main","index":0}]]},"Parse Payload":{"main":[[{"node":"Route Action","type":"main","index":0}]]},"Route Action":{"main":[[{"node":"Handle VLK","type":"main","index":0}],[{"node":"Handle Surgery","type":"main","index":0}],[{"node":"Handle Discharge","type":"main","index":0}],[{"node":"Handle VLK Done","type":"main","index":0}],[{"node":"Handle VLK Extend","type":"main","index":0}],[{"node":"Handle Dovidka","type":"main","index":0}],[{"node":"Handle Signed","type":"main","index":0}],[{"node":"Handle Fill Form","type":"main","index":0}],[{"node":"Handle Generate","type":"main","index":0}],[],[{"node":"Handle Details","type":"main","index":0}]]},"Handle VLK":{"main":[[{"node":"Respond VLK","type":"main","index":0}]]},"Handle Surgery":{"main":[[{"node":"Respond Surgery","type":"main","index":0}]]},"Respond VLK":{"main":[[{"node":"Acknowledge","type":"main","index":0}]]},"Respond Surgery":{"main":[[{"node":"Acknowledge 2","type":"main","index":0}]]},"Handle VLK Done":{"main":[[{"node":"Respond VLK Done","type":"main","index":0}]]},"Respond VLK Done":{"main":[[{"node":"Acknowledge VLK Done","type":"main","index":0}]]},"Handle VLK Extend":{"main":[[{"node":"Update Airtable VLK","type":"main","index":0}]]},"Update Airtable VLK":{"main":[[{"node":"Respond VLK Extend","type":"main","index":0}]]},"Respond VLK Extend":{"main":[[{"node":"Acknowledge VLK Extend","type":"main","index":0}]]},"Handle Discharge":{"main":[[{"node":"Get Patient","type":"main","index":0}]]},"Get Patient":{"main":[[{"node":"Build Form URL","type":"main","index":0}]]},"Copy Template":{"main":[[{"node":"Fill Document","type":"main","index":0}]]},"Fill Document":{"main":[[{"node":"Format Response","type":"main","index":0}]]},"Format Response":{"main":[[{"node":"Respond Discharge","type":"main","index"