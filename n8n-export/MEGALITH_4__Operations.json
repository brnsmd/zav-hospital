      "id": "get-tomorrow-ops",
      "name": "Get Tomorrow Ops",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [
        250,
        600
      ],
      "credentials": {
        "airtableTokenApi": {
          "id": "oB0crB7qKyJOGI5a",
          "name": "Airtable Personal Access Token account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const ops = $input.all();\nconst tomorrow = new Date();\ntomorrow.setDate(tomorrow.getDate() + 1);\nconst dateStr = tomorrow.toLocaleDateString('uk-UA', { weekday: 'long', day: 'numeric', month: 'long' });\n\nlet text = `*ПЛАН ОПЕРАЦІЙ НА ${dateStr.toUpperCase()}*\\n\\n`;\n\nif (ops.length === 0) {\n  text += 'Операцій не заплановано';\n} else {\n  text += `Всього: ${ops.length} операцій\\n\\n`;\n  for (let i = 0; i < ops.length; i++) {\n    const f = ops[i].json.fields || ops[i].json;\n    text += `${i+1}. *${f['Пацієнт'] || 'TBD'}*\\n`;\n    text += `   Операція: ${f['Назва операції'] || '-'}\\n`;\n    text += `   Хірург: ${f['Хірург'] || '-'}\\n`;\n    text += `   Час: ${f['Час'] || '-'}\\n\\n`;\n  }\n}\n\nreturn [{ json: { text, channel: 'C0AACFEURNX' } }];"
      },
