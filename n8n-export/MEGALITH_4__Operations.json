    {
      "parameters": {
        "jsCode": "const ops = $input.all();\nconst now = new Date();\nconst hour = now.getHours();\n\nlet text = `*ЧЕКЛІСТ ОПЕРАЦІЙ (${hour}:00)*\\n\\n`;\ntext += `Залишилось: ${ops.length} операцій\\n\\n`;\n\nfor (const o of ops) {\n  const f = o.json.fields || o.json;\n  const patient = f['Пацієнт'] || 'TBD';\n  const surgeon = f['Хірург'] || '-';\n  const time = f['Час'] || '-';\n  const status = f['Статус'] || 'Очікує';\n  \n  text += `*${patient}*\\n`;\n  text += `   Хірург: ${surgeon} | Час: ${time}\\n`;\n  text += `   Статус: ${status}\\n\\n`;\n}\n\nreturn [{ json: { text, channel: 'C0AACFEURNX' } }];"
      },
